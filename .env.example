# Copy to .env and fill in. Keep comments on their own lines: python-dotenv treats
# an inline "# comment" after a value as part of the value.

# Required for any live LLM call (Phase 0 smoke, Phases 2-5)
ANTHROPIC_API_KEY=

# Optional second provider (cross-family judge / extra generation model)
OPENAI_API_KEY=

# Required when a deepseek-* model is used (config judge). Get one at platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional (gated Hugging Face datasets in Phase 1)
HF_TOKEN=

# REQUIRED for ReliefWeb API v2: a PRE-APPROVED appname (request via https://apidoc.reliefweb.int/
# or feedback@reliefweb.int; enforced since 2025-11-01). Leave empty until approved -> the manual
# collection fallback (docs/manual_collection.md) is used instead.
RELIEFWEB_APPNAME=

# OpenRouter (cross-family judge, e.g. openai/gpt-5.6-luna). openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional attribution headers shown on OpenRouter's dashboard
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
